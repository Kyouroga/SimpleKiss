{
  "id": "simplekiss",
  "name": "SimpleKiss",
  "version": "${projectVersion}",
  "description": "A proximity-based kiss effects in Minecraft.",
  "authors": [
    "kyouroga"
  ],
  "main": "org.kyouroga.simplekiss.velocity.VelocityPlugin",
  "apiVersion": 1.21,
  "commands": {
    "spkiss": {
      "description": "SimpleKiss plugin commands",
      "usage": "/<command> toggle <true | false>"
    }
  },
  "permissions": {
    "simplekiss.reload": {
      "description": "Allows reloading the SimpleKiss configuration.",
      "default": "op"
    }
  }
}
